---
import SermonEpisode from '../../components/SermonEpisode.astro';
import Site from '../../layouts/Site.astro';
import { sermons, type Sermon } from '../../lib/content';

export function getStaticPaths() {
  return sermons.map(sermon => ({ params: { slug: sermon.slug }, props: { sermon } }));
}
const { sermon } = Astro.props as { sermon: Sermon };
---
<Site title={sermon.title}>
  <SermonEpisode sermon={sermon} />
</Site>
