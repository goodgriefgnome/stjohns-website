---
import Site from '../../layouts/Site.astro';
import { displayDate, safeHref, sermons, type Sermon } from '../../lib/content';

export function getStaticPaths() {
  return sermons.map(sermon => ({ params: { slug: sermon.slug }, props: { sermon } }));
}
const { sermon } = Astro.props as { sermon: Sermon };
const audio = safeHref(sermon.audioUrl);
---
<Site title={sermon.title}>
  <div class="title-band">
    <div class="wrap">
      <a href="/sermons">All sermons</a>
      <h1>{sermon.title}</h1>
    </div>
  </div>
  <article class="wrap content">
    <div class="prose">
      <dl class="metadata">
        <div><dt>Date</dt><dd><time datetime={sermon.date}>{displayDate(sermon.date)}</time></dd></div>
        <div><dt>Scripture</dt><dd>{sermon.scripture}</dd></div>
        <div><dt>Series</dt><dd>{sermon.series}</dd></div>
        <div><dt>Preacher</dt><dd>{sermon.preacher}</dd></div>
      </dl>
      {audio && <audio controls preload="none" src={audio}><a href={audio}>Listen to the recording</a></audio>}
      {sermon.description.map(paragraph => <p>{paragraph}</p>)}
    </div>
  </article>
</Site>
