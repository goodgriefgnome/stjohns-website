---
import Page from '../layouts/Page.astro';
import ActionLink from '../components/ActionLink.astro';
import Home from '../../content/index.mdx';
import { withBase } from '../lib/base-path.mjs';
---
<Page title="Home" width="standard">
  <header class="hero hero-home photo-backdrop" data-palette="navy" slot="hero">
    <img src={withBase('/media/hero-door.webp')} alt="" fetchpriority="high" />
    <img class="hero-cycle" src={withBase('/media/hero-community.webp')} alt="" />
    <div class="wrap">
      <h1>Truth, Beauty, and Goodness for the heart of the city.</h1>
      <ActionLink href="/new" variant="filled">Plan a visit</ActionLink>
    </div>
  </header>
  <Home />
</Page>

<style>
  /* The only home-page-specific design: two photos that fade between each other behind the tagline. */
  .hero-home {
    --scrim: var(--photo-scrim-light);
    min-height: var(--hero-home-height);
    padding: calc(var(--home-header-height) + var(--space-xl)) 0 var(--section-spacing);
    text-align: center;
  }
  .hero-home img { border-radius: var(--hero-arch); max-height: var(--hero-photo-max-height); }
  .hero-home h1 { font-size: var(--font-hero); margin-bottom: var(--space-md); }
  .hero-cycle { animation: hero-cycle 16s infinite; opacity: 0; }
  @keyframes hero-cycle {
    0%, 41%, 100% { opacity: 0; }
    50%, 91% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-cycle { display: none; } }
  @container style(--screen: medium) or style(--screen: wide) { .hero-home img { max-height: none; } }
  @container style(--screen: medium) { .hero-home { padding-top: calc(var(--home-header-height) + var(--space-2xs)); } }
  @container style(--screen: wide) { .hero-home { padding-top: calc(var(--home-header-height) + var(--space-md)); } }
</style>
