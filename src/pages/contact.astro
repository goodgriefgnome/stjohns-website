---
import church from '../../inputs/church.json';
import ActionLink from '../components/ActionLink.astro';
import Page from '../layouts/Page.astro';
import ContentSection from '../components/ContentSection.astro';
---
<Page title="Contact Us">
  <ContentSection>
    <h2>We would love to hear from you</h2>
    <ActionLink href={`tel:${church.telephone}`}>{church.telephoneLabel}</ActionLink>
    <ActionLink href={`mailto:${church.email}`}>{church.email}</ActionLink>
    <address>{church.streetAddress}, {church.locality} {church.region} {church.postcode}<br />{church.postalAddress}</address>
    <ActionLink href={church.directionsUrl}>Get directions</ActionLink>
  </ContentSection>
  <ContentSection>
    <h2>FAQs</h2>
    <p>We are located just 350m from King’s Cross Station in Darlinghurst. If you are traveling here by car, there is parking in the basement of the HammondCare building next door and in the neighbourhood nearby the church. </p>
  </ContentSection>
</Page>
