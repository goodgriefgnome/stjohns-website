---
import AudioPlayer from '../components/AudioPlayer.astro';
import Hero from '../components/Hero.astro';
import SermonArchive from '../components/SermonArchive.astro';
import SermonFeature from '../components/SermonFeature.astro';
import Page from '../layouts/Page.astro';
import { withBase } from '../lib/base-path.mjs';
import { mainPodcastUrl } from '../lib/church.mjs';
import { displayDate, sermons } from '../lib/content';
import { blurb, minutes } from '../lib/sermon-format.mjs';

const latest = sermons[0];
if (!latest) throw new Error('There are no sermons in imported/sermons.');
const episode = withBase(`/episode/${latest.slug}`);
---
<Page title="Our Sermons">
  <Hero title="Our Sermons" slot="hero">
    <p class="actions"><a class="action action-filled" href={mainPodcastUrl}>Subscribe</a></p>
  </Hero>
  <section class="section-outer latest" data-palette="navy">
    <div class="section-inner">
      <SermonFeature artwork={latest.artwork}>
        <p class="label">Latest sermon · <time datetime={latest.date}>{displayDate(latest.date)}</time></p>
        <h2><a href={episode}>{latest.title}</a></h2>
        <p class="meta">{latest.scripture} · {latest.preacher} · {minutes(latest.durationSeconds)} min</p>
        <AudioPlayer src={latest.audioUrl} durationSeconds={latest.durationSeconds} title={latest.title} artist={latest.preacher} album={latest.series} artwork={latest.artwork?.podcastSrc} />
        <p class="blurb">{blurb(latest.description)}</p>
        <p class="links"><a class="action action-bar" href={episode}>Notes and details</a></p>
      </SermonFeature>
    </div>
  </section>
  <SermonArchive />
</Page>

<style>
  .label { margin: 0 0 var(--space-2xs); }
  h2 { margin: 0 0 var(--space-2xs); text-align: left; }
  h2 a { color: inherit; text-decoration: none; }
  .meta { margin: 0 0 var(--space-md); }
  .blurb { margin: var(--space-md) 0; }
  .links { margin: 0; }
  .action { margin: 0; }
</style>
