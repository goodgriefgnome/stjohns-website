---
import Page from '../layouts/Page.astro';
import ContentSection from '../components/ContentSection.astro';
---
<Page title="Community Pantry">
  <ContentSection>
    <p class="body-copy">Come to St John's for tea, coffee, groceries and friendship.</p>
  </ContentSection>
  <ContentSection image="/media/d9bd8bb2c95d96887db9.webp" alt="">
    <h2>We're here to help with our new Community Pantry</h2>
    <p class="body-copy">Please come and join us for tea, coffee and biscuits every other Wednesday between 10am and 11am.
Our Community Pantry offers two bags of groceries worth $50 for $15 each. </p>
    <p class="body-copy">The Community Pantry will start on Wednesday 11 February and then every other Wednesday through the year.</p>
    <p class="body-copy">Email for more information.</p>
  </ContentSection>
</Page>
