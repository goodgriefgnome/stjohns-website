---
import ActionLink from '../components/ActionLink.astro';
import church from '../../inputs/church.json';
import Page from '../layouts/Page.astro';
import ContentSection from '../components/ContentSection.astro';
---
<Page title="Community Pantry">
  <ContentSection>
    <p>Come to St John's for tea, coffee, groceries and friendship.</p>
  </ContentSection>
  <ContentSection image="/media/d9bd8bb2c95d96887db9.webp" alt="">
    <h2>We're here to help with our new Community Pantry</h2>
    <p>Please come and join us for tea, coffee and biscuits.
Our Community Pantry offers two bags of groceries worth $50 for $15 each. </p>
    <ActionLink href="/#upcoming-events">Check the calendar for pantry dates</ActionLink>
    <ActionLink href={`mailto:${church.email}`}>Email for more information</ActionLink>
  </ContentSection>
</Page>
