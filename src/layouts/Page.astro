---
import { palettes } from '../lib/palettes.mjs';
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  width?: 'standard' | 'reading';
  hero?: string;
  heroSubtitle?: string;
  palette?: typeof palettes[number];
  prose?: boolean;
}
const { width = 'standard', ...options } = Astro.props;
---
<PageLayout width={width} {...options}>
  <slot />
</PageLayout>
