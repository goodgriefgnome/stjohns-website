---
import PageLayout from './PageLayout.astro';
import ContentSection from '../components/ContentSection.astro';

interface PageOptions {
  title: string;
  hero?: string;
}
type Props = PageOptions | { frontmatter: PageOptions };

const props = Astro.props;
const { title, hero } = 'frontmatter' in props ? props.frontmatter : props;
---
<PageLayout title={title} width="standard" hero={hero}>
  {'frontmatter' in props ? <ContentSection><slot /></ContentSection> : <slot />}
</PageLayout>
