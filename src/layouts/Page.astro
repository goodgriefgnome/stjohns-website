---
import { withBase } from '../lib/base-path.mjs';
import { palettes } from '../lib/palettes.mjs';
import Site from './Site.astro';

interface Props {
  title: string;
  width?: 'standard' | 'reading';
  hero?: string;
  heroFocus?: [number, number];
  heroSubtitle?: string;
  palette?: typeof palettes[number];
}
const { title, width = 'standard', hero, heroFocus, heroSubtitle, palette } = Astro.props;
if (palette && !palettes.includes(palette)) throw new Error(`Unknown page palette: ${palette}`);
const isReading = width === 'reading';
const Frame = isReading ? 'article' : 'div';
const focalPoint = heroFocus?.map(coordinate => `${coordinate}%`).join(' ');
---
<Site title={title} photoHeader={Boolean(hero)}>
  <Frame data-palette={palette ?? (isReading ? 'cream' : undefined)}>
    {hero ? (
      <header class="article-hero" data-palette="navy">
        <img src={withBase(hero)} alt="" fetchpriority="high" style={focalPoint && { objectPosition: focalPoint }} />
        <div>
          <h1>{title}</h1>
          {heroSubtitle && <p class="hero-subtitle">{heroSubtitle}</p>}
        </div>
      </header>
    ) : (
      <div class="title-band"><div class="wrap"><h1>{title}</h1></div></div>
    )}
    <div class:list={['page-content', { 'standard-measure': !isReading }]}>
      <slot />
    </div>
  </Frame>
</Site>

<style>
  .title-band { background: var(--surface-subtle); text-align: center; padding-block: 3.75rem; }
  .title-band h1 { margin-bottom: 0; }
  .article-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: clamp(17rem, 35vw, 25rem);
    padding: var(--home-header-height) var(--gutter) 3rem;
    text-align: center;
  }
  .article-hero img {
    position: absolute;
    inset: 0;
    z-index: -2;
    height: 100%;
    object-fit: cover;
  }
  .article-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--photo-scrim); }
  .article-hero h1 { margin: 0; }
  .hero-subtitle { margin: 1rem 0 0; }
  .page-content {
    --page-measure: var(--reading-width);
    display: grid;
    grid-template-columns: minmax(var(--gutter), 1fr) minmax(0, var(--page-measure)) minmax(var(--gutter), 1fr);
    padding-bottom: var(--article-spacing);
  }
  .page-content.standard-measure {
    --page-measure: var(--layout-width);
    padding-block: var(--section-spacing);
  }
  .page-content :global(> *) { grid-column: 2; }
  .page-content:not(.standard-measure) :global(> :first-child) { margin-top: var(--article-spacing); }
  .page-content :global(> :is(.article-band, .article-gallery)) { grid-column: 1 / -1; }
  .page-content :global(> .article-band) {
    margin: 0 0 var(--article-spacing);
    padding: var(--article-spacing) max(var(--gutter), calc((100% - var(--page-measure)) / 2));
  }
  .page-content.standard-measure:has(:global(> .article-band:first-child)) { padding-top: 0; }
  .page-content :global(> .article-band-wide) {
    padding-inline: max(var(--gutter), calc((100% - var(--layout-width)) / 2));
  }
  .page-content :global(.section-columns) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--gutter);
    margin-top: 2rem;
  }
  .page-content :global(.article-media) {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
  }
  .page-content :global(.article-media[data-image='right']) { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  .page-content :global(.article-media[data-image='right'] .media-image) { order: 1; }
  .page-content :global(.article-media .media-image img) { width: 100%; aspect-ratio: 1; object-fit: cover; max-height: none; }
  .page-content :global(.media-body > :last-child) { margin-bottom: 0; }
  .page-content :global(.article-band > :last-child) { margin-bottom: 0; }
  .page-content :global(.article-band + .article-band) { margin-top: calc(-1 * var(--article-spacing)); }
  .page-content :global(.article-band img) { max-height: 30rem; object-fit: contain; }
  .page-content :global(details summary) { font-weight: 700; font-size: 1.45rem; }
  .page-content :global(details[open] summary) { margin-bottom: 1rem; }
  .page-content :global(.article-lead) { text-align: center; }
  .page-content :global(blockquote) { margin: 0; }
  .page-content :global(.article-lead p:last-child) { margin-bottom: 0; }
  .page-content :global(> .article-gallery) {
    width: min(calc(100% - 2 * var(--gutter)), var(--layout-width));
    margin: 2rem auto 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1rem;
    list-style: none;
  }
  .page-content :global(.article-gallery img) { aspect-ratio: 1; object-fit: cover; }
  @media (max-width: 56rem) {
    .article-hero { padding-top: 8rem; }
  }
  @media (max-width: 42rem) {
    .page-content :global(> .article-gallery) { grid-auto-flow: row; }
    .page-content :global(.section-columns-explicit) { grid-template-columns: 1fr; }
    .page-content :global(.article-media),
    .page-content :global(.article-media[data-image='right']) { grid-template-columns: 1fr; }
    .page-content :global(.article-media[data-image='right'] .media-image) { order: 0; }
  }
</style>
