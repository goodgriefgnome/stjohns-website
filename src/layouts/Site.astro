---
import { withBase } from '../lib/base-path.mjs';
import SiteNavigation from '../components/SiteNavigation.astro';
import { getEntry, render } from 'astro:content';
import '../styles/screen.css';
import '../../theme/tokens.css';
import '../../theme/roles.css';
import '../styles/base.css';
import '../styles/patterns/page-grid.css';
import '../styles/patterns/section.css';
import '../styles/patterns/photo-backdrop.css';
import '../styles/patterns/hero.css';
import '../styles/patterns/wrap.css';
import '../styles/patterns/visually-hidden.css';
import '../styles/patterns/site-footer.css';
import '../styles/components/action.css';
import '../styles/components/icon.css';
import '../styles/components/accordion.css';
import '../styles/components/date.css';
import 'virtual:theme-layouts.css';
import 'virtual:theme-behaviours.css';
const footer = await getEntry('parts', '_footer');
if (!footer) throw new Error('content/_footer.md is missing.');
const { Content: FooterContent } = await render(footer);
const { title, home = false, photoHeader = false } = Astro.props;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={withBase("/fonts/inter-latin.woff2")} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | St John’s Darlinghurst</title>
  </head>
  <body class:list={{ "is-home": home, "has-photo-header": photoHeader }}>
    <a class="skip" href="#content">Skip to content</a>
    <SiteNavigation home={home || photoHeader} />
    <main id="content"><slot /></main>
    <footer class="site-footer"><FooterContent /></footer>
  </body>
</html>

<style>
  .skip { position: absolute; top: var(--space-sm); left: var(--space-sm); transform: translateY(-200%); z-index: 10; background: var(--paper); padding: var(--space-2xs); }
  .skip:focus { transform: none; }
</style>
