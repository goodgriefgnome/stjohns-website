---
import { withBase } from '../lib/base-path.mjs';
import SiteNavigation from '../components/SiteNavigation.astro';
import church from '../../inputs/church.json';
import '../styles/tokens.css';
import '../styles/roles.css';
import '../styles/base.css';
import '../styles/patterns/page-grid.css';
import '../styles/patterns/band.css';
import '../styles/patterns/columns.css';
import '../styles/patterns/cards.css';
import '../styles/patterns/media.css';
import '../styles/patterns/gallery.css';
import '../styles/patterns/photo-backdrop.css';
import '../styles/patterns/wrap.css';
import '../styles/components/action.css';
import '../styles/components/icon.css';
import '../styles/components/accordion.css';
import '../styles/components/date.css';
const { title, home = false, photoHeader = false } = Astro.props;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={withBase("/fonts/inter-latin.woff2")} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | St John’s Darlinghurst</title>
  </head>
  <body class:list={{ "is-home": home, "has-photo-header": photoHeader }}>
    <a class="skip" href="#content">Skip to content</a>
    <SiteNavigation home={home || photoHeader} />
    <main id="content"><slot /></main>
    <footer class="site-footer" data-palette="navy">
      <div class="wrap footer-content">
        <div><h2>Email</h2><a href={`mailto:${church.email}`}>{church.email}</a></div>
        <div><h2>Call Us</h2><a href={`tel:${church.telephone}`}>{church.telephoneLabel}</a></div>
        <div><h2>Find Us</h2><a href={church.directionsUrl}>{church.streetAddress}, {church.locality} {church.postcode}</a></div>
      </div>
      <div class="footer-social">
        <a href="https://www.instagram.com/stjohnsdarlinghurst">Instagram</a>
        <a href="https://www.youtube.com/channel/UC_hFhunnSSLzBTvbNmgjZ9g">YouTube</a>
        <a href="https://www.facebook.com/stjohnsdarlo/">Facebook</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; top: .75rem; left: .75rem; transform: translateY(-200%); z-index: 10; background: var(--paper); padding: .5rem; }
  .skip:focus { transform: none; }
  .is-home, .has-photo-header { --home-header-height: 11rem; }
  .footer-social { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.4rem; padding: 0 1rem var(--band-spacing-small); }
  .footer-content { display: grid; grid-template-columns: 1fr; gap: 1rem; text-align: center; padding-block: var(--band-spacing-small); }
  .footer-content h2 { font-size: var(--font-subheading); }
  @container style(--screen: medium) or style(--screen: wide) {
    .footer-content { grid-template-columns: repeat(3, 1fr); }
  }
</style>
