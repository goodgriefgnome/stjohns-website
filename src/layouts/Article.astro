---
import { palettes } from '../lib/palettes.mjs';
import PageLayout from './PageLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    hero?: string | null;
    heroSubtitle?: string;
    palette?: typeof palettes[number];
  };
}
const { frontmatter } = Astro.props;
const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1);
const hero = frontmatter.hero === undefined ? `/media/articles/${slug}.webp` : frontmatter.hero ?? undefined;
---
<PageLayout title={frontmatter.title} width="reading" hero={hero} heroSubtitle={frontmatter.heroSubtitle} palette={frontmatter.palette}>
  <slot />
</PageLayout>
