---
import { withBase } from '../lib/base-path.mjs';
import { mainPodcastUrl, serviceName } from '../lib/church.mjs';
import { displayDate, safeHref, type Sermon } from '../lib/content';
import { blurb, minutes, seriesSlug } from '../lib/sermon-format.mjs';
import AudioPlayer from './AudioPlayer.astro';
import SermonFeature from './SermonFeature.astro';

// The navy section at the top of the sermons pages: the sermon being shown, with its player and its notes.
// The page script swaps this whole section when someone picks another sermon (src/lib/sermon-swap.ts), so it carries
// data-sermon-feature (what gets swapped) and data-slug (which sermon it is).
interface Props {
  sermon: Sermon;
  /** The newest sermon, labelled "Latest sermon". Otherwise the label is the date and service. */
  latest?: boolean;
  /** Show the full description and facts straight away. */
  notesOpen?: boolean;
}
const { sermon, latest = false, notesOpen = false } = Astro.props;
const audio = safeHref(sermon.audioUrl);
const page = withBase(`/sermons/${sermon.slug}`);
---
<section class="section-outer" data-palette="navy" data-sermon-feature data-slug={sermon.slug}>
  <div class="section-inner">
    <SermonFeature artwork={sermon.artwork}>
      <p class="label">{latest
        ? <>Latest sermon · <time datetime={sermon.date}>{displayDate(sermon.date)}</time></>
        : <><time datetime={sermon.date}>{displayDate(sermon.date)}</time> · {serviceName(sermon.service)}</>}</p>
      <h2 tabindex="-1"><a href={page}>{sermon.title}</a></h2>
      <p class="meta">{sermon.scripture} · {sermon.preacher} · {minutes(sermon.durationSeconds)} min</p>
      {audio && <AudioPlayer src={audio} durationSeconds={sermon.durationSeconds} title={sermon.title} artist={sermon.preacher} album={sermon.series} artwork={sermon.artwork?.podcastSrc} />}
      <div class="notes-host">
        <p class="blurb">{blurb(sermon.description)}</p>
        <details open={notesOpen}>
          <summary class="action action-bar">Notes and details</summary>
          <div class="notes">
            {sermon.description.map(paragraph => <p>{paragraph}</p>)}
            <dl class="facts">
              <div><dt class="label">Passage</dt><dd>{sermon.scripture}</dd></div>
              <div><dt class="label">Preacher</dt><dd><a href={withBase(`/sermons?preacher=${encodeURIComponent(sermon.preacher)}`)}>{sermon.preacher}</a></dd></div>
              <div><dt class="label">Series</dt><dd><a href={withBase(`/sermons?series=${seriesSlug(sermon.series)}`)}>{sermon.series}</a></dd></div>
            </dl>
            <p class="links">{audio && <><a href={audio} download>Download MP3</a> · </>}<a href={mainPodcastUrl}>Subscribe to the podcast</a></p>
          </div>
        </details>
      </div>
    </SermonFeature>
  </div>
</section>

<style>
  .label { margin: 0 0 var(--space-2xs); }
  h2 { margin: 0 0 var(--space-2xs); text-align: left; }
  h2 a { color: inherit; text-decoration: none; }
  .meta { margin: 0 0 var(--space-md); }
  .blurb { margin: var(--space-md) 0; }
  /* The blurb is the first paragraph of the notes, so it hides while they are open. */
  .notes-host:has(details[open]) .blurb { display: none; }
  /* The summary looks like a bar link (see action.css), without the browser's triangle. */
  summary { margin: var(--space-md) 0 0; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .notes { margin-top: var(--space-md); }
  /* Field names beside their values. */
  .facts { display: grid; grid-template-columns: auto 1fr; gap: var(--space-2xs) var(--space-md); margin: var(--space-lg) 0; }
  .facts div { display: contents; }
  .facts dt { align-self: center; margin: 0; }
  .facts dd { margin: 0; }
  .links { margin: 0; font-size: var(--font-small); }
</style>
