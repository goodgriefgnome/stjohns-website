---
import { withBase } from '../lib/base-path.mjs';
import { serviceName } from '../lib/church.mjs';
import { displayDate, safeHref, type Sermon } from '../lib/content';
import AudioPlayer from './AudioPlayer.astro';
import SermonFeature from './SermonFeature.astro';

// The navy section at the top of the sermons pages: the sermon being shown, with its player and its notes.
// The page script swaps this whole section when someone picks another sermon (src/lib/sermon-swap.ts), so it carries
// data-sermon-feature (what gets swapped) and data-slug (which sermon it is).
interface Props {
  sermon: Sermon;
  /** The newest sermon, labelled "Latest sermon". Otherwise the label is the date and service. */
  latest?: boolean;
  /** Show the full description and facts straight away. */
  notesOpen?: boolean;
}
const { sermon, latest = false, notesOpen = false } = Astro.props;
const audio = safeHref(sermon.audioUrl);
const rest = sermon.description.slice(1);
const page = withBase(`/sermons/${sermon.slug}`);
---
<section class="section-outer" data-palette="navy" data-sermon-feature data-slug={sermon.slug}>
  <div class="section-inner">
    <SermonFeature artwork={sermon.artwork}>
      <p class="label">{latest
        ? <>Latest sermon · <time datetime={sermon.date}>{displayDate(sermon.date)}</time></>
        : <><time datetime={sermon.date}>{displayDate(sermon.date)}</time> · {serviceName(sermon.service)}</>}</p>
      <h2 tabindex="-1"><a href={page}>{sermon.title}</a></h2>
      <p class="meta">{sermon.scripture} · <a class="quiet-link" href={withBase(`/sermons?preacher=${encodeURIComponent(sermon.preacher)}`)}>{sermon.preacher}</a></p>
      {audio && <AudioPlayer src={audio} durationSeconds={sermon.durationSeconds} title={sermon.title} artist={sermon.preacher} album={sermon.series} artwork={sermon.artwork?.podcastSrc} downloadHref={audio} />}
      <div class="notes">
        <p class="first">{sermon.description[0]}</p>
        {rest.length > 0 && (
          <details open={notesOpen}>
            <summary class="action action-bar"><span class="when-closed">Notes and details</span><span class="when-open">Show less</span></summary>
            {rest.map(paragraph => <p>{paragraph}</p>)}
          </details>
        )}
      </div>
    </SermonFeature>
  </div>
</section>

<style>
  .label { margin: 0 0 var(--space-2xs); }
  h2 { margin: 0 0 var(--space-2xs); text-align: left; }
  h2 a { color: inherit; text-decoration: none; }
  .meta { margin: 0 0 var(--space-md); }
  .first { margin: var(--space-md) 0 var(--space-sm); }
  /* Length of the slide when the notes open or close. */
  details { --notes-slide: 300ms; display: grid; }  /* grid, not flex: the slide does not animate inside a flex details */
  /* The button is first in the HTML, as details requires, but shows under the text it reveals; keyboard and screen readers meet it first, which is the natural order for them. */
  summary { order: 1; margin: var(--space-md) 0 0; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .when-open { display: none; }
  details[open] .when-open { display: inline; }
  details[open] .when-closed { display: none; }
  /* The hidden paragraphs slide open. Browsers without interpolate-size or ::details-content just open at once. */
  @media (prefers-reduced-motion: no-preference) {
    details { interpolate-size: allow-keywords; }
    details::details-content { block-size: 0; overflow: clip; transition: block-size var(--notes-slide) var(--ease-live), content-visibility var(--notes-slide) allow-discrete; }
    details[open]::details-content { block-size: auto; }
  }
</style>
