---
import ContentSection from './ContentSection.astro';

interface TeamMember {
  name: string;
  role: string;
  biography: string[];
  order: number;
}

const team = Object.values(import.meta.glob<TeamMember>('../../inputs/team/*.json', { eager: true, import: 'default' }))
  .sort((a, b) => a.order - b.order);
---
<ContentSection>
    {team.map(member => (
      <article class="team-member">
        <h2>{member.name}</h2>
        <p><strong>{member.role}</strong></p>
        {member.biography.map(paragraph => <p>{paragraph}</p>)}
      </article>
    ))}
</ContentSection>
