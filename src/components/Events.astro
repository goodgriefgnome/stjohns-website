---
import { withBase } from '../lib/base-path.mjs';
import { safeHref } from '../lib/content';
import { byMonth, describes, displayDay, displayRecurrence, displayTimes, eventDays, months, series, today, upcoming } from '../lib/events';
const weekdays = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const rowDate = (date: string) => new Intl.DateTimeFormat('en-AU', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(date + 'T00:00:00Z')).replace(',', '');
const monthLabel = (key: string) => months.find(month => month.key === key)?.label ?? key;
const seen = new Set<string>();
---
<div class="events">
  <nav class="event-calendar" aria-label="Event dates">
    <div class="calendar-months">
      {months.map((month, index) => {
        const previous = months[index - 1];
        const next = months[index + 1];
        return <div class="calendar-month" id={`cal-${month.key}`}>
          <div class="calendar-header">
            {previous ? <a href={`#cal-${previous.key}`} aria-label={`Previous month, ${previous.label}`}>‹</a> : <span aria-hidden="true">‹</span>}
            <p>{month.label}</p>
            {next ? <a href={`#cal-${next.key}`} aria-label={`Next month, ${next.label}`}>›</a> : <span aria-hidden="true">›</span>}
          </div>
          <div class="weekdays" aria-hidden="true">{weekdays.map(day => <span>{day}</span>)}</div>
          <ol class="days" role="list">
            {month.days.map(day => (
              <li data-date={day.date} class:list={{ past: day.date < today, today: day.date === today }} style={day.day === 1 ? `grid-column-start: ${day.weekday + 1}` : undefined}>
                {eventDays.has(day.date)
                  ? <a href={`#d-${day.date}`} aria-label={displayDay(day.date)}>{day.day}</a>
                  : <span>{day.day}</span>}
              </li>
            ))}
          </ol>
        </div>;
      })}
    </div>
  </nav>

  <div class="event-list" tabindex="0" aria-label="Upcoming events">
    <p class="events-empty" hidden={upcoming.length > 0}>No upcoming events are listed.</p>
    {[...byMonth].map(([month, occurrences]) => (
      <section class="month">
        <h3>{monthLabel(month)}</h3>
        <ul class="rows" role="list">
          {occurrences.map(event => {
            const register = event.registrationUrl && safeHref(event.registrationUrl);
            const meta = [displayTimes(event), displayRecurrence(event), event.location].filter(Boolean).join(' · ');
            const id = seen.has(event.startDate) ? undefined : (seen.add(event.startDate), `d-${event.startDate}`);
            return <li class="event-row" id={id} data-date={event.startDate} data-series={series(event)} data-end={event.end}>
              <div class="main">
                <span class="title">{event.title}</span>
                {(meta || register) && <span class="meta">{meta}{meta && register ? ' · ' : ''}{register && <a href={withBase(register)}>Register</a>}</span>}
                {describes(event) && <span class="blurb">{event.description}</span>}
              </div>
              <time class="when" datetime={event.startDate}>{rowDate(event.startDate)}</time>
            </li>;
          })}
        </ul>
      </section>
    ))}
  </div>
</div>

<script>
  // The build only knows the day it ran. In the browser, hide what has finished since,
  // mark today on the mini calendar, and scroll within the boxes instead of jumping the page.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Sydney' }).format(new Date());
  const now = Date.now();
  for (const root of document.querySelectorAll<HTMLElement>('.events')) {
    const list = root.querySelector<HTMLElement>('.event-list')!;
    const strip = root.querySelector<HTMLElement>('.calendar-months')!;

    for (const row of root.querySelectorAll<HTMLElement>('.event-row')) row.hidden = Date.parse(row.dataset.end!) <= now;
    root.querySelector<HTMLElement>('.events-empty')!.hidden = !!root.querySelector('.event-row:not([hidden])');

    // A repeating series shows its description once, on its next occurrence.
    for (const blurb of root.querySelectorAll('.event-row .blurb')) {
      const { series } = blurb.closest<HTMLElement>('.event-row')!.dataset;
      root.querySelector(`.event-row[data-series="${series}"]:not([hidden]) .main`)?.append(blurb);
    }

    for (const day of root.querySelectorAll<HTMLElement>('li[data-date]')) {
      if (!day.closest('.calendar-month')) continue;
      day.classList.toggle('past', day.dataset.date! < today);
      day.classList.toggle('today', day.dataset.date === today);
    }
    const thisMonth = root.querySelector<HTMLElement>(`#cal-${today.slice(0, 7)}`);
    if (thisMonth) strip.scrollLeft = thisMonth.offsetLeft;

    root.addEventListener('click', click => {
      const link = (click.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      const target = link && root.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      click.preventDefault();
      const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto';
      if (strip.contains(target)) return strip.scrollTo({ left: target.offsetLeft, behavior: smooth });
      const header = target.closest('.month')!.querySelector<HTMLElement>('h3')!;
      // Stop a little short of the pinned month name, so the end of the previous row peeks out.
      const peek = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
      list.scrollTo({ top: target.offsetTop - header.offsetHeight - peek, behavior: smooth });
    });
  }
</script>
<style>
  .events {
    --line: color-mix(in srgb, currentColor 25%, transparent);
    /* Quieter text (dates, counts, descriptions): the section's own text colour, faded, so it works on every palette. */
    --quiet: color-mix(in srgb, currentColor 70%, transparent);
    --calendar-width: 17rem;
    /* One date in the calendar, and the gap between weeks. */
    --cell: var(--space-xl);
    --cell-gap: var(--space-3xs);
    /* The calendar's height, worked out from its parts: header + weekday letters + six weeks. */
    --calendar-height: calc(var(--cell) + var(--space-2xs) + var(--space-lg) + 6 * var(--cell) + 5 * var(--cell-gap));
    /* The list box is half as tall again as the calendar (1.5 times). */
    --list-height-ratio: 1.5;
    --list-height: calc(var(--calendar-height) * var(--list-height-ratio));
    /* Without a calendar beside it, the list stops growing at this height and scrolls. */
    --list-max-height: 70vh;
    /* How much of the previous row stays visible above a date the calendar scrolls to. */
    --peek: var(--space-md);
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); margin-top: var(--space-xl); text-align: left;
  }
  .event-calendar { display: none; }
  .calendar-months { position: relative; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .calendar-month { flex: 0 0 100%; scroll-snap-align: start; }
  .calendar-header { display: flex; justify-content: space-between; align-items: center; height: var(--cell); margin-bottom: var(--space-2xs); }
  .calendar-header p { margin: 0; font-weight: var(--weight-strong); }
  .calendar-header :is(a, span) { display: grid; place-items: center; min-width: var(--tap-target); height: var(--cell); font-size: var(--font-h3); line-height: 1; text-decoration: none; }
  .calendar-header span { opacity: .35; }
  .weekdays, .days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); text-align: center; font-size: var(--font-label); }
  .weekdays { height: var(--space-lg); font-weight: var(--weight-label); }
  .days { grid-auto-rows: var(--cell); row-gap: var(--cell-gap); margin: 0; padding: 0; list-style: none; }
  .days :is(a, span) { position: relative; display: grid; place-items: center; width: var(--cell); height: var(--cell); margin-inline: auto; border-radius: var(--radius-round); text-decoration: none; }
  /* A day with events: bold, with a small dot under the number. */
  .days a { font-weight: var(--weight-strong); }
  .days a::after { content: ''; position: absolute; bottom: var(--space-3xs); left: calc(50% - var(--dot-size) / 2); width: var(--dot-size); height: var(--dot-size); border-radius: var(--radius-round); background: currentColor; }
  .days a:hover { background: color-mix(in srgb, currentColor 12%, transparent); }
  .days .past { opacity: .4; }
  .days .today :is(a, span) { box-shadow: inset 0 0 0 var(--line-thin) currentColor; }

  .event-list { position: relative; display: grid; gap: var(--space-xl); align-content: start; min-width: 0; max-height: var(--list-max-height); overflow-y: auto; overscroll-behavior: contain; padding-right: var(--space-sm); }
  /* Month name stays pinned at the top of the box while its rows scroll under it. */
  .month h3 { position: sticky; top: 0; z-index: 1; margin: 0; padding-bottom: var(--space-sm); background: var(--section-bg); text-align: left; }
  .month:not(:has(.event-row:not([hidden]))), .event-row[hidden], [hidden] { display: none; }
  .rows { list-style: none; padding: 0; margin: 0; border-top: var(--line-thin) solid var(--line); }
  .event-row { scroll-margin-top: var(--peek); display: grid; grid-template-columns: 1fr auto; gap: var(--space-sm); padding: var(--space-sm) 0; border-bottom: var(--line-thin) solid var(--line); }
  .main { display: grid; gap: var(--space-3xs); min-width: 0; }
  .title { font-weight: var(--weight-label); font-size: var(--font-body); }
  .meta { font-size: var(--font-small); }
  .events-empty { margin: 0; }
  .blurb { font-size: var(--font-small); color: var(--quiet); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
  .when { font-size: var(--font-small); color: var(--quiet); white-space: nowrap; }
  @container style(--section-size: wide) {
    .events { grid-template-columns: var(--calendar-width) minmax(0, var(--reading-width)); justify-content: center; align-items: start; column-gap: calc(var(--space-xl) * 2); }
    .event-calendar { display: block; }
    .event-list { height: var(--list-height); max-height: none; }
  }
</style>
