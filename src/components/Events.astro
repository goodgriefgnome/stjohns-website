---
import { withBase } from '../lib/base-path.mjs';
import { safeHref } from '../lib/content';
import { byDay, byMonth, describes, displayDay, displayRecurrence, displayTimes, eventDays, months, series, today, upcoming } from '../lib/events';
const weekdays = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const monthLabel = (key: string) => months.find(month => month.key === key)?.label ?? key;
---
<div class="events">
  <nav class="event-calendar" aria-label="Event dates">
    <div class="calendar-months">
      {months.map((month, index) => {
        const previous = months[index - 1];
        const next = months[index + 1];
        return <div class="calendar-month" id={`cal-${month.key}`}>
          <div class="calendar-header">
            {previous ? <a href={`#cal-${previous.key}`} aria-label={`Previous month, ${previous.label}`}>‹</a> : <span aria-hidden="true">‹</span>}
            <p>{month.label}</p>
            {next ? <a href={`#cal-${next.key}`} aria-label={`Next month, ${next.label}`}>›</a> : <span aria-hidden="true">›</span>}
          </div>
          <div class="weekdays" aria-hidden="true">{weekdays.map(day => <span>{day}</span>)}</div>
          <ol class="days" role="list">
            {month.days.map(day => (
              <li data-date={day.date} class:list={{ past: day.date < today, today: day.date === today }} style={day.day === 1 ? `grid-column-start: ${day.weekday + 1}` : undefined}>
                {eventDays.has(day.date)
                  ? <a href={`#d-${day.date}`} aria-label={displayDay(day.date)}>{day.day}</a>
                  : <span>{day.day}</span>}
              </li>
            ))}
          </ol>
        </div>;
      })}
    </div>
  </nav>

  <div class="event-list" tabindex="0" aria-label="Upcoming events">
    <p class="events-empty" hidden={upcoming.length > 0}>No upcoming events are listed.</p>
    {[...byMonth].map(([month, occurrences]) => (
      <section class="event-month">
        <h3>{monthLabel(month)}</h3>
        {[...byDay(occurrences)].map(([date, dayEvents]) => (
          <section class="event-day" id={`d-${date}`}>
            <h4><time datetime={date}>{displayDay(date)}</time></h4>
            {dayEvents.map(event => {
              const register = event.registrationUrl && safeHref(event.registrationUrl);
              const when = [displayTimes(event), displayRecurrence(event)].filter(Boolean).join(' · ');
              return <article class="event" data-series={series(event)} data-end={event.end}>
                <h5>{event.title}</h5>
                {when && <p>{when}</p>}
                {event.location && <p>{event.location}</p>}
                {describes(event) && <p class="description">{event.description}</p>}
                {register && <p><a href={withBase(register)}>Register</a></p>}
              </article>;
            })}
          </section>
        ))}
      </section>
    ))}
  </div>
</div>

<script>
  // The build only knows the day it ran. In the browser, hide what has finished since,
  // mark today on the mini calendar, and scroll within the boxes instead of jumping the page.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Sydney' }).format(new Date());
  const now = Date.now();
  for (const root of document.querySelectorAll<HTMLElement>('.events')) {
    const list = root.querySelector<HTMLElement>('.event-list')!;
    const strip = root.querySelector<HTMLElement>('.calendar-months')!;

    for (const event of root.querySelectorAll<HTMLElement>('.event')) event.hidden = Date.parse(event.dataset.end!) <= now;
    for (const group of root.querySelectorAll<HTMLElement>('.event-day, .event-month')) group.hidden = !group.querySelector('.event:not([hidden])');
    root.querySelector<HTMLElement>('.events-empty')!.hidden = !!root.querySelector('.event:not([hidden])');

    // A repeating series shows its description once, on its next occurrence.
    for (const description of root.querySelectorAll('.event .description')) {
      const { series } = description.closest<HTMLElement>('.event')!.dataset;
      root.querySelector(`.event[data-series="${series}"]:not([hidden])`)?.append(description);
    }

    for (const day of root.querySelectorAll<HTMLElement>('[data-date]')) {
      day.classList.toggle('past', day.dataset.date! < today);
      day.classList.toggle('today', day.dataset.date === today);
    }
    const thisMonth = root.querySelector<HTMLElement>(`#cal-${today.slice(0, 7)}`);
    if (thisMonth) strip.scrollLeft = thisMonth.offsetLeft;

    root.addEventListener('click', click => {
      const link = (click.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      const target = link && root.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      click.preventDefault();
      const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto';
      if (strip.contains(target)) strip.scrollTo({ left: target.offsetLeft, behavior: smooth });
      else list.scrollTo({ top: target.offsetTop, behavior: smooth });
    });
  }
</script>

<style>
  .events {
    --line: color-mix(in srgb, currentColor 25%, transparent);
    /* Width of the mini calendar beside the list. */
    --calendar-width: 17rem;
    /* How tall the event list gets before it scrolls, when there is no calendar beside it. */
    --list-max-height: 70vh;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-halves);
    text-align: left;
  }

  /* Mini calendar: one month at a time, in a strip that snaps between months. */
  .event-calendar {
    display: none;
    align-self: start;
    padding: var(--space-sm);
    border: var(--line-thin) solid var(--line);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, currentColor 6%, transparent);
  }
  .calendar-months {
    position: relative;
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .calendar-month { flex: 0 0 100%; scroll-snap-align: start; }
  .calendar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2xs); }
  .calendar-header p { margin: 0; font-weight: var(--weight-strong); }
  .calendar-header :is(a, span) { display: grid; place-items: center; min-width: var(--tap-target); min-height: var(--tap-target); font-size: var(--font-h3); line-height: 1; text-decoration: none; }
  .calendar-header span { opacity: .35; }
  .weekdays, .days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); text-align: center; font-size: var(--font-label); }
  .weekdays { font-weight: var(--weight-label); padding-bottom: var(--space-3xs); }
  .days { margin: 0; padding: 0; list-style: none; }
  .days :is(a, span) { position: relative; display: block; padding: var(--space-2xs) 0; border-radius: var(--radius-sm); text-decoration: none; }
  .days a { font-weight: var(--weight-strong); }
  .days a::after { content: ''; position: absolute; bottom: var(--space-3xs); left: calc(50% - var(--dot-size) / 2); width: var(--dot-size); height: var(--dot-size); border-radius: var(--radius-round); background: currentColor; }
  .days a:hover { background: color-mix(in srgb, currentColor 12%, transparent); }
  .days .past { opacity: .4; }
  .days .today :is(a, span) { font-weight: var(--weight-title); box-shadow: inset 0 0 0 var(--line-thin) currentColor; }

  /* The list scrolls inside a box as tall as the calendar beside it. */
  .event-list {
    position: relative;
    max-height: var(--list-max-height);
    overflow-y: auto;
    padding-right: var(--space-2xs);
  }
  /* Gaps rather than margins, so groups the script hides leave no space behind. */
  .event-list, .event-month { display: grid; align-content: start; gap: var(--space-md); }
  .event-list { gap: var(--space-xl); }
  .event-month h3 { margin: 0; }
  [hidden] { display: none; }
  .event-day h4 { margin: 0; font-size: var(--font-label); font-weight: var(--weight-label); text-transform: uppercase; letter-spacing: var(--letter-spacing-label); }
  .event { padding: var(--space-2xs) 0; border-bottom: var(--line-thin) solid var(--line); }
  .event h5 { margin: 0; font-size: var(--font-body); font-weight: var(--weight-label); line-height: 1.45; }
  .event p { margin: var(--space-3xs) 0 0; font-size: var(--font-small); }
  .description { overflow-wrap: anywhere; }

  /* Wide bands add the mini calendar. Narrow ones (phones) skip it and the list gets most of the screen. */
  @container style(--band-size: wide) {
    .events { grid-template-columns: var(--calendar-width) minmax(0, 1fr); }
    .event-calendar { display: block; }
    .event-list { contain: size; max-height: none; }
  }
</style>
