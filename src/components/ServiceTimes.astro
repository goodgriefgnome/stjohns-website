---
import { church, formatServiceTime, listSeparator } from '../lib/church.mjs';

const times = church.sundayServiceTimes;
---
{times.map((time, index) => (
  <>{listSeparator(index, times.length)}<time datetime={time}>{formatServiceTime(time)}</time></>
))}

<style>
  time { color: inherit; }
</style>
