---
import church from '../../inputs/church.json';

const formatter = new Intl.DateTimeFormat('en-AU', {
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
  timeZone: 'UTC',
});
const times = church.sundayServiceTimes;
---
{times.map((time, index) => (
  <>{index > 0 && (index === times.length - 1 ? ' and ' : ', ')}<time datetime={time}>{formatter.format(new Date(`2000-01-01T${time}:00Z`)).replace(/:00|\s/g, '').toLowerCase()}</time></>
))}
