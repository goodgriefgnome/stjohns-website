---
import { displayDate, sermons } from '../lib/content';
---
<ul class="sermon-list">
  {sermons.map(sermon => (
    <li>
      <time datetime={sermon.date}>{displayDate(sermon.date)}</time>
      <h3><a href={`/episode/${sermon.slug}`}>{sermon.title}</a></h3>
      <p>{sermon.scripture} · {sermon.preacher}</p>
    </li>
  ))}
</ul>

<style>
  .sermon-list { list-style: none; padding: 0; }
  .sermon-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; }
  .sermon-list li { border: 1px solid var(--border-subtle); padding: 1.2rem; }
  .sermon-list h3 { margin: .35rem 0; }
  .sermon-list p { margin: 0; }
</style>
