---
import { withBase } from '../lib/base-path.mjs';
import { displayDate, sermons } from '../lib/content';
---
<ul class="sermon-list" role="list">
  {sermons.map(sermon => (
    <li>
      <time class="date" datetime={sermon.date}>{displayDate(sermon.date)}</time>
      <h3><a href={withBase(`/episode/${sermon.slug}`)}>{sermon.title}</a></h3>
      <p>{sermon.scripture} · {sermon.preacher}</p>
    </li>
  ))}
</ul>

<style>
  /* Narrowest a sermon card gets before the row wraps. */
  .sermon-list { --card-width: 16rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-width)), 1fr)); gap: var(--space-sm); }
  .sermon-list li { border: var(--line-thin) solid var(--border-subtle); padding: var(--space-md); }
  .sermon-list h3 { margin: var(--space-3xs) 0; }
  .sermon-list p { margin: 0; }
</style>
