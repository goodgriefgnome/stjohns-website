---
import '../styles/components/sermon-list.css';
import { withBase } from '../lib/base-path.mjs';
import type { Sermon } from '../lib/content';
import { blurb, bookOf, minutes, seriesSlug, shortDay, titleWithoutSeries } from '../lib/sermon-format.mjs';

// A list of sermons, one row each: title, passage and preacher, a one-line blurb, then the date and length on the right.
// Used by the sermons page (under each series) and the home page. The data-* attributes are what the filters read (src/lib/sermon-filters.ts). Styles: styles/components/sermon-list.css.
interface Props {
  sermons: Sermon[];
  /** Drop "Series name: " from titles, for rows shown under their series' heading. */
  underSeries?: boolean;
}
const { sermons, underSeries = false } = Astro.props;
---
<ol class="sermon-rows" role="list">
  {sermons.map(sermon => (
    <li
      data-slug={sermon.slug}
      data-series={seriesSlug(sermon.series)}
      data-preacher={sermon.preacher}
      data-book={bookOf(sermon.scripture)}
      data-search={[sermon.title, sermon.scripture, sermon.preacher, sermon.series].join(' ').toLowerCase()}
    >
      <div class="sermon-main">
        <a class="sermon-title" href={withBase(`/sermons/${sermon.slug}`)}>{underSeries ? titleWithoutSeries(sermon.title, sermon.series) : sermon.title}</a>
        <span class="sermon-meta">{sermon.scripture} · {sermon.preacher}</span>
        <span class="sermon-blurb">{blurb(sermon.description)}</span>
      </div>
      <span class="sermon-when"><time datetime={sermon.date}>{shortDay(sermon.date)}</time><span>{minutes(sermon.durationSeconds)} min</span></span>
    </li>
  ))}
</ol>
