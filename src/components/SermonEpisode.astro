---
import { withBase } from '../lib/base-path.mjs';
import { displayDate, safeHref, type Sermon } from '../lib/content';

interface Props {
  sermon: Sermon;
}
const { sermon } = Astro.props;
const audio = safeHref(sermon.audioUrl);
---
  <article class="wrap content episode">
    <h1>{sermon.title}</h1>
    <p class="episode-date"><time datetime={sermon.date}>{displayDate(sermon.date)}</time></p>
    {sermon.artwork && <img class="episode-art" src={withBase(sermon.artwork.src)} alt={sermon.artwork.alt} fetchpriority="high" />}
    {audio && <audio controls preload="none" src={audio}><a href={audio}>Listen to the recording</a></audio>}
    <div class="prose">
      <dl class="metadata">
        <div><dt>Scripture</dt><dd>{sermon.scripture}</dd></div>
        <div><dt>Series</dt><dd>{sermon.series}</dd></div>
        <div><dt>Preacher</dt><dd>{sermon.preacher}</dd></div>
      </dl>
      {sermon.description.map(paragraph => <p>{paragraph}</p>)}
      <a href={withBase("/sermons")}>All sermons</a>
    </div>
  </article>

<style>
  .episode { max-width: 59.5rem; padding-top: 4.6rem; }
  .episode-date { margin-bottom: 2.8rem; }
  .episode-art { margin-bottom: 1.5rem; }
  .episode audio { width: 100%; margin-bottom: 2rem; }
  .metadata { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1rem; margin: 0 0 1.5rem; }
  dt { font-size: .875rem; font-weight: 650; }
  dd { margin: 0; }
</style>
