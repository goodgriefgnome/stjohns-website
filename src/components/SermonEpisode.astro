---
import { displayDate, safeHref, type Sermon } from '../lib/content';

interface Props {
  sermon: Sermon;
}
const { sermon } = Astro.props;
const audio = safeHref(sermon.audioUrl);
---
  <article class="wrap content episode">
    <h1>{sermon.title}</h1>
    <p class="episode-date"><time datetime={sermon.date}>{displayDate(sermon.date)}</time></p>
    {sermon.artwork && <img class="episode-art" src={sermon.artwork.src} alt={sermon.artwork.alt} fetchpriority="high" />}
    {audio && <audio controls preload="none" src={audio}><a href={audio}>Listen to the recording</a></audio>}
    <div class="prose">
      <dl class="metadata">
        <div><dt>Scripture</dt><dd>{sermon.scripture}</dd></div>
        <div><dt>Series</dt><dd>{sermon.series}</dd></div>
        <div><dt>Preacher</dt><dd>{sermon.preacher}</dd></div>
      </dl>
      {sermon.description.map(paragraph => <p>{paragraph}</p>)}
      <a href="/sermons">All sermons</a>
    </div>
  </article>
