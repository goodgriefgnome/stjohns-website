---
import { withBase } from '../lib/base-path.mjs';
import { clock } from '../lib/sermon-format.mjs';

// A compact player for a sermon's audio. Without JavaScript the browser's own player shows;
// with it, the script below swaps that for a round play button, the time, a thin position bar and the length.
interface Props {
  src: string;
  durationSeconds: number;
  title: string;
  /** Shown on the phone's lock screen. */
  artist: string;
  album: string;
  /** Square artwork for the lock screen, a path starting with "/". */
  artwork?: string;
}
const { src, durationSeconds, title, artist, album, artwork } = Astro.props;
---
<div class="player" data-player data-title={title} data-artist={artist} data-album={album} data-artwork={artwork && withBase(artwork)}>
  <audio controls preload="none" src={src}></audio>
  <div class="controls" hidden>
    <button type="button" class="play" aria-label="Play">
      <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" fill="currentColor" /></svg>
      <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 2.5h3.5v11H3.5zM9 2.5h3.5v11H9z" fill="currentColor" /></svg>
    </button>
    <span class="time elapsed">0:00</span>
    <input class="slider" type="range" min="0" max={durationSeconds} step="1" value="0" aria-label="Position" />
    <span class="time total">{clock(durationSeconds)}</span>
  </div>
</div>

<script>
  import { startPlayers } from '../lib/audio-player';
  startPlayers();
</script>

<style>
  /* Size of the round play button, and of the slider's round handle. */
  .player { --button-size: 3rem; --thumb-size: .875rem; }
  .player audio { width: 100%; }
  .controls { display: flex; align-items: center; gap: var(--space-sm); }
  .controls[hidden] { display: none; }
  .play {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--button-size);
    height: var(--button-size);
    padding: 0;
    border: 0;
    border-radius: var(--radius-round);
    background: var(--action-bg, var(--sky));
    color: var(--action-text, var(--paper));
    cursor: pointer;
  }
  .play svg { width: 40%; }
  /* The play triangle looks centred a little to the right of true centre. */
  .icon-play { margin-left: 8%; }
  .icon-pause { display: none; }
  [data-playing] .icon-play { display: none; }
  [data-playing] .icon-pause { display: block; }
  .time { font-size: var(--font-label); font-variant-numeric: tabular-nums; }

  /* The position slider: a thin bar with a round handle. The played part is filled using --played (0 to 1), which the script sets. */
  .slider {
    --played: 0;
    flex: 1;
    min-width: 0;
    height: var(--tap-target);
    margin: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    appearance: none;
  }
  .slider::-webkit-slider-runnable-track {
    height: var(--line-bar);
    border-radius: var(--radius-pill);
    background: linear-gradient(to right, currentColor calc(var(--played) * 100%), var(--bar-track) 0);
  }
  .slider::-webkit-slider-thumb {
    appearance: none;
    width: var(--thumb-size);
    height: var(--thumb-size);
    margin-top: calc((var(--line-bar) - var(--thumb-size)) / 2);
    border: 0;
    border-radius: var(--radius-round);
    background: currentColor;
  }
  .slider::-moz-range-track { height: var(--line-bar); border-radius: var(--radius-pill); background: var(--bar-track); }
  .slider::-moz-range-progress { height: var(--line-bar); border-radius: var(--radius-pill); background: currentColor; }
  .slider::-moz-range-thumb { width: var(--thumb-size); height: var(--thumb-size); border: 0; border-radius: var(--radius-round); background: currentColor; }
</style>
