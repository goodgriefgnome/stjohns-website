---
import { palettes } from '../lib/palettes.mjs';

interface Props {
  palette?: typeof palettes[number];
  image?: string;
  alt?: string;
}
const { image, alt = '', palette } = Astro.props;
if (palette !== undefined && !palettes.includes(palette)) {
  throw new Error(`Unknown section palette: ${palette}`);
}
---
<section data-palette={palette} class:list={['content-section', { 'with-photo': image }]}>
  {image && <img src={image} alt={alt} loading="lazy" />}
  <div class="prose">
    <slot />
  </div>
</section>

<style>
  .content-section + .content-section { border-top: 1px solid var(--border-subtle); margin-top: 2rem; padding-top: 2rem; }
  .with-photo { display: grid; grid-template-columns: minmax(12rem, .65fr) minmax(0, 1fr); align-items: start; gap: clamp(1rem, 4vw, 3rem); }
  .with-photo > img { border-radius: .3rem; max-height: 29rem; object-fit: cover; }
  .prose { max-width: 70ch; }
  .prose :global(h2:not(:first-child)) { margin-top: 1.75rem; }
  .prose :global(p) { white-space: pre-line; overflow-wrap: anywhere; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--border-subtle); margin-block: 2rem; }
  .prose :global(address) { font-style: normal; margin-bottom: 1rem; }
  @media (max-width: 42rem) {
    .with-photo { grid-template-columns: 1fr; }
  }
</style>
